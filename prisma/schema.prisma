generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth / Auth.js v5) ────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role          @default(ADMIN)
  accountStatus AccountStatus @default(ACTIVE)
  timezone      String        @default("UTC")
  emailPrefs    Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]      @relation("ProjectLead")
  tasks         Task[]         @relation("TaskAssignee")
  activities    Activity[]
  notifications Notification[]
  memberships   ProjectMember[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  VIEWER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  VIEWER
  EDITOR
}

enum MemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum ProjectCategory {
  CONSULTANCY
  RESEARCH
  PROPOSAL
  BUSINESS_DEVELOPMENT
  PERSONAL
  TRAINING
  OPERATIONS
}

enum ProjectStatus {
  NOT_STARTED
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum DeliverableType {
  PROPOSAL
  REPORT
  PROTOCOL
  PRESENTATION
  PUBLICATION
  DATASET
  POLICY_BRIEF
  MEETING
  INVOICE
  CONTRACT
  OTHER
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  SUBMITTED
}

enum ResourceCategory {
  GOOGLE_DRIVE
  DROPBOX
  GITHUB
  SHAREPOINT
  MEETING_LINK
  REFERENCE
  DATASET
  PUBLICATION
  GUIDELINE
  OTHER
}

enum NotificationType {
  TASK_DUE
  PROJECT_DEADLINE
  MILESTONE_APPROACHING
  FILE_UPLOADED
  TASK_OVERDUE
  REMINDER
  PROJECT_COMPLETED
  GENERAL
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id            String          @id @default(cuid())
  name          String
  shortName     String?
  description   String?
  category      ProjectCategory @default(CONSULTANCY)
  clientName    String?
  organization  String?
  fundingAgency String?
  country       String?
  startDate     DateTime?
  endDate       DateTime?
  status        ProjectStatus   @default(NOT_STARTED)
  priority      Priority        @default(MEDIUM)
  progress      Int             @default(0)
  colorLabel    String?
  budget        Float?
  notes         String?
  leadId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  lead           User?           @relation("ProjectLead", fields: [leadId], references: [id])
  tasks          Task[]
  recurringTasks RecurringTask[]
  milestones     Milestone[]
  deliverables Deliverable[]
  files        ProjectFile[]
  resources    Resource[]
  projectNotes ProjectNote[]
  activities   Activity[]
  contacts     Contact[]
  tags         TagOnProject[]
  members      ProjectMember[]
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus @default(TODO)
  priority      Priority   @default(MEDIUM)
  startDate     DateTime?
  dueDate       DateTime?
  reminderDate        DateTime?
  estimatedTime       Float?
  actualTime          Float?
  completionPct       Int                  @default(0)
  order               Int                  @default(0)
  projectId           String
  assigneeId          String?
  parentTaskId        String?
  recurrenceFrequency RecurrenceFrequency?
  recurrenceEndsAt    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  parentTask Task?           @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[]          @relation("TaskSubtasks")
  checklist  ChecklistItem[]
  comments   TaskComment[]
  files      TaskFile[]
  links      TaskLink[]
  tags       TagOnTask[]

  dependencies Task[] @relation("TaskDependencies")
  dependents   Task[] @relation("TaskDependencies")
}

model RecurringTask {
  id           String              @id @default(cuid())
  title        String
  description  String?
  priority     Priority            @default(MEDIUM)
  projectId    String
  frequency    RecurrenceFrequency
  durationDays Int                 @default(1)
  startingFrom DateTime
  endsAt       DateTime?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChecklistItem {
  id     String  @id @default(cuid())
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  size      Int
  mimeType  String
  taskId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskLink {
  id        String   @id @default(cuid())
  title     String
  url       String
  taskId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─── Milestones ──────────────────────────────────────────────────────────────

model Milestone {
  id            String          @id @default(cuid())
  name          String
  description   String?
  targetDate    DateTime?
  completionPct Int             @default(0)
  status        MilestoneStatus @default(NOT_STARTED)
  projectId     String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverables Deliverable[]
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id          String            @id @default(cuid())
  name        String
  type        DeliverableType   @default(OTHER)
  status      DeliverableStatus @default(PENDING)
  deadline    DateTime?
  responsible String?
  version     String?
  projectId   String
  milestoneId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id])
  files     ProjectFile[]
}

// ─── Files ───────────────────────────────────────────────────────────────────

model ProjectFile {
  id            String   @id @default(cuid())
  name          String
  originalName  String
  url           String
  size          Int
  mimeType      String
  version       String?
  description   String?
  category      String?
  projectId     String
  deliverableId String?
  uploadedById  String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverable Deliverable? @relation(fields: [deliverableId], references: [id])
}

// ─── Resources ───────────────────────────────────────────────────────────────

model Resource {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    ResourceCategory @default(OTHER)
  url         String
  notes       String?
  projectId   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tags    TagOnResource[]
}

// ─── Notes ───────────────────────────────────────────────────────────────────

model ProjectNote {
  id        String   @id @default(cuid())
  title     String?
  content   String   @default("")
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Contact {
  id           String   @id @default(cuid())
  name         String
  email        String?
  phone        String?
  organization String?
  role         String?
  projectId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Activity ─────────────────────────────────────────────────────────────────

model Activity {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  entityName String?
  projectId  String?
  userId     String
  createdAt  DateTime @default(now())

  project Project? @relation(fields: [projectId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType @default(GENERAL)
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  userId    String
  projectId String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Tags ────────────────────────────────────────────────────────────────────

model Tag {
  id       String          @id @default(cuid())
  name     String          @unique
  color    String          @default("#6366f1")
  projects TagOnProject[]
  tasks    TagOnTask[]
  resources TagOnResource[]
}

model TagOnProject {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model TagOnTask {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model TagOnResource {
  resourceId String
  tagId      String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
}

// ─── Platform Invites ─────────────────────────────────────────────────────────

model PlatformInvite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  tokenExpiry DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Collaborators ────────────────────────────────────────────────────────────

model ProjectMember {
  id          String       @id @default(cuid())
  projectId   String
  userId      String?
  email       String
  role        MemberRole
  status      MemberStatus @default(PENDING)
  inviteToken String?      @unique
  tokenExpiry DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id])
  sessions ViewerSession[]
}

model ViewerSession {
  id             String        @id @default(cuid())
  memberId       String
  requesterEmail String
  token          String        @unique @default(cuid())
  expiresAt      DateTime?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())

  member ProjectMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
}
